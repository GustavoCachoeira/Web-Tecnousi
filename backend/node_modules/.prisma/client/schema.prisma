generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  password  String
  name      String
  role      String         @default("user") // "user" ou "admin"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  quotes    QuoteRequest[]
}

model QuoteRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  service     String
  description String?
  filePaths   Json // Array de caminhos para arquivos enviados
  status      String   @default("pendente") // "pendente", "em análise", "aprovado", "rejeitado"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imagePath   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
